# VPN Configuration
# Copy this file to .env and fill in your values

# Google Cloud Project ID
# Used by: setup-secrets.sh, server scripts
PROJECT_ID=your-project-id

# Google Cloud Zone
# Used by: setup-secrets.sh (derives region for Secret Manager)
# Default: asia-south1-a
ZONE=asia-south1-a

# VM Service Account
# Used by: setup-secrets.sh (grants secret access to this service account)
# This is the service account attached to your VPN VMs
# Format: service-account-name@your-project-id.iam.gserviceaccount.com
VM_SERVICE_ACCOUNT=your-vm-service-account@your-project-id.iam.gserviceaccount.com

# VPN Server Endpoint
# Used by: generate-client.sh (client configs)
# Direct VM IP or static IP (GCP load balancers incompatible with WireGuard)
VPN_ENDPOINT=your-vm-static-ip

# Instance Configuration
INSTANCE_NAME=vpn-server
TEMPLATE_NAME=vpn-template
