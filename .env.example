# VPN Configuration
# Copy this file to .env and fill in your values

# Google Cloud Project ID
# Used by: setup-secrets.sh, server scripts
PROJECT_ID=your-project-id

# Google Cloud Zone
# Used by: setup-secrets.sh (derives region for Secret Manager)
# Default: asia-south1-a
ZONE=asia-south1-a

# VPN Load Balancer Endpoint
# Used by: generate-client.sh (client configs)
# This is the public IP of the UDP load balancer (port 51820)
VPN_ENDPOINT=your-server-ip-or-domain
